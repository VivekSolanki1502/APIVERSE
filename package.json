{
  "name": "apiverse",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source API discovery, testing and budget intelligence platform.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "check": "npm run lint && npm run typecheck && npm run backend:typecheck && npm run worker:typecheck && npm run validate:catalog && npm run test && npm run test:backend && npm run build && npm run backend:build && npm run worker:dry-run",
    "check:links": "tsx scripts/check-links.ts",
    "pricing:watch": "tsx scripts/pricing-watch.ts",
    "backend:dev": "tsx watch backend/src/server.ts",
    "backend:start": "node dist-backend/server.js",
    "backend:build": "esbuild backend/src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-backend/server.js",
    "backend:typecheck": "tsc -p backend/tsconfig.json",
    "test:backend": "tsx --test backend/tests/*.node.ts",
    "worker:typecheck": "tsc -p cloudflare/tsconfig.json",
    "worker:prepare": "node scripts/prepare-cloudflare.mjs",
    "worker:dry-run": "npm run worker:prepare && wrangler deploy --dry-run",
    "deploy:cloudflare": "npm run build && npm run worker:prepare && wrangler deploy",
    "d1:local": "wrangler d1 migrations apply apiverse --local",
    "d1:remote": "wrangler d1 migrations apply apiverse --remote"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "wrangler": "^4.151.2"
  }
}
