# Public URL of your GitHub repository. When empty, APIverse hides repository links
# instead of linking to a placeholder.
VITE_REPO_URL=
# Optional public API origin for deployed frontend. Leave blank for same-origin/local proxy.
VITE_API_BASE_URL=
# Optional Vite dev proxy destination when the backend is not on 127.0.0.1:3001.
API_PROXY_TARGET=http://127.0.0.1:3001
